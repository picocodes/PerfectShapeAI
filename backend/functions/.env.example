# Firebase Admin. On Cloud Functions the default service account is enough and these can be empty.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n escapes, or use a real multiline value locally.
FIREBASE_PRIVATE_KEY=

# Cloudflare AI Gateway, OpenAI-compatible.
# Example: https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/compat
CLOUDFLARE_AI_BASE_URL=
# Gateway auth token. Sent as cf-aig-authorization. CLOUDFLARE_AI_KEY is accepted as an alias.
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_AI_KEY=
# Provider key stored only on the server. Never ship this in the app.
AI_PROVIDER_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# Store identity. These match the Flutter application id.
APPLE_BUNDLE_ID=com.perfectshapeai.app
ANDROID_PACKAGE_NAME=com.perfectshapeai.app

# Optional App Store Server API, used to refresh a subscription when the phone does not send a new StoreKit 2 JWS.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Google Play Android Publisher API. Provide one of these. Never commit the file or the JSON.
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Local dev server only (npm run dev). Ignored on Cloud Functions and when NODE_ENV=production.
ALLOW_DEV_AUTH=
PORT=8787
